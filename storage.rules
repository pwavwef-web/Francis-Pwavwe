rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null
             && request.auth.token.email == 'pwavwef@gmail.com';
    }

    // Project files - only pwavwef@gmail.com can upload/download/delete
    match /projects/{userId}/{allPaths=**} {
      allow read, write, delete: if request.auth != null 
                                 && request.auth.token.email == 'pwavwef@gmail.com'
                                 && request.auth.uid == userId;
    }

    // Podcast media generated by the admin upload flow. Read access is public
    // because listener pages stream cover art/audio from these URLs.
    match /podcast/{userId}/{allPaths=**} {
      allow read: if true;
      allow write, delete: if isAdmin() && request.auth.uid == userId;
    }
  }
}
