{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "**/*.dart",
      "pubspec.yaml",
      "francis_old.html",
      "francis.html.backup"
    ],
    "cleanUrls": true,
    "trailingSlash": false,
    "404": "404.html"
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "storage": {
    "rules": "storage.rules"
  }
}
