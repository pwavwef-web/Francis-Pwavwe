rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
             && request.auth.token.email == 'pwavwef@gmail.com';
    }

    // Pwavwe Studio data is submitted and administered through trusted
    // callable Functions. The optional claim supports trusted direct tooling;
    // ordinary authentication is intentionally insufficient.
    function isBuildStudioAdmin() {
      return request.auth != null
             && request.auth.token.buildStudioAdmin == true;
    }

    match /buildRequests/{requestId} {
      allow read, create, update, delete: if isBuildStudioAdmin();
    }

    match /marketingConsents/{consentId} {
      allow read, create, update, delete: if isBuildStudioAdmin();
    }

    match /buildRequestActivity/{activityId} {
      allow read: if isBuildStudioAdmin();
      allow create, update, delete: if false;
    }

    match /_buildRateLimits/{documentId} {
      allow read, write: if false;
    }

    match /_buildDuplicateKeys/{documentId} {
      allow read, write: if false;
    }

    match /_buildReferences/{documentId} {
      allow read, write: if false;
    }

    // Testimonials / project feedback. The full record (including the author's
    // email and any private feedback) is only reachable through trusted callable
    // Functions — never by the public, even when the testimonial is published.
    match /testimonials/{testimonialId} {
      allow read, create, update, delete: if isBuildStudioAdmin();
    }

    // Display-safe, publicly readable projection. It is written only by the
    // Admin SDK inside a callable Function (which bypasses these rules), so no
    // client may ever write to it; anyone may read the approved quotes.
    match /publicTestimonials/{testimonialId} {
      allow read: if true;
      allow write: if false;
    }

    match /testimonialActivity/{activityId} {
      allow read: if isBuildStudioAdmin();
      allow create, update, delete: if false;
    }

    match /_feedbackRateLimits/{documentId} {
      allow read, write: if false;
    }

    match /_feedbackReferences/{documentId} {
      allow read, write: if false;
    }

    function hasPodcastEpisodeShape() {
      return request.resource.data.keys().hasAll(['title', 'description', 'season', 'episode', 'isPublished'])
             && request.resource.data.title is string
             && request.resource.data.description is string
             && request.resource.data.season is number
             && request.resource.data.episode is number
             && request.resource.data.isPublished is bool;
    }

    // Messages collection
    match /messages/{messageId} {
      // Allow authenticated admin (pwavwef@gmail.com) to read and delete
      allow read, delete: if request.auth != null 
                          && request.auth.token.email == 'pwavwef@gmail.com';
      
      // Allow anyone to create messages (from website contact form)
      allow create: if request.resource.data.keys().hasAll(['name', 'email', 'subject', 'message', 'timestamp'])
                    && request.resource.data.name is string
                    && request.resource.data.email is string
                    && request.resource.data.subject is string
                    && request.resource.data.message is string;
    }

    // Newsletter subscribers (from the website subscribe form).
    // The document ID is a random unsubscribe token, so a newsletter link of the
    // form /unsubscribe?t=<docId> can opt the reader out without granting anyone
    // read access to the subscriber list.
    match /subscribers/{subscriberId} {
      // Anyone may subscribe; shape is pinned so the collection stays clean.
      allow create: if request.resource.data.keys().hasOnly(['email', 'source', 'status', 'timestamp'])
                    && request.resource.data.keys().hasAll(['email', 'timestamp'])
                    && request.resource.data.email is string
                    && request.resource.data.email.size() < 320
                    && request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$');
      // Holding the token allows exactly one thing: opting out. No other field
      // may change, and the record can never be flipped back to subscribed.
      allow update: if request.resource.data.diff(resource.data)
                         .affectedKeys().hasOnly(['status', 'unsubscribedAt'])
                    && request.resource.data.status == 'unsubscribed';
      // Only admin can read or clear the list.
      allow read, delete: if isAdmin();
    }

    // Unsubscribe-by-email requests (fallback when the token link is missing)
    match /unsubscribeRequests/{requestId} {
      allow create: if request.resource.data.keys().hasOnly(['email', 'timestamp'])
                    && request.resource.data.email is string
                    && request.resource.data.email.size() < 320
                    && request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$');
      allow read, delete: if isAdmin();
      allow update: if false;
    }

    // Transactions collection (for finances)
    match /transactions/{transactionId} {
      allow read: if request.auth != null 
                  && request.auth.token.email == 'pwavwef@gmail.com';
      allow create: if request.auth != null 
                    && request.auth.token.email == 'pwavwef@gmail.com'
                    && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null 
                            && request.auth.token.email == 'pwavwef@gmail.com'
                            && resource.data.userId == request.auth.uid;
    }

    // Tasks collection (for planning)
    match /tasks/{taskId} {
      allow read: if request.auth != null 
                  && request.auth.token.email == 'pwavwef@gmail.com';
      allow create: if request.auth != null 
                    && request.auth.token.email == 'pwavwef@gmail.com'
                    && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null 
                            && request.auth.token.email == 'pwavwef@gmail.com'
                            && resource.data.userId == request.auth.uid;
    }

    // Blogs collection
    match /blogs/{blogId} {
      allow read: if request.auth != null 
                  && request.auth.token.email == 'pwavwef@gmail.com';
      allow create: if request.auth != null 
                    && request.auth.token.email == 'pwavwef@gmail.com'
                    && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null 
                            && request.auth.token.email == 'pwavwef@gmail.com'
                            && resource.data.userId == request.auth.uid;
    }

    // Project files collection
    match /projectFiles/{fileId} {
      allow read: if request.auth != null 
                  && request.auth.token.email == 'pwavwef@gmail.com';
      allow create: if request.auth != null 
                    && request.auth.token.email == 'pwavwef@gmail.com'
                    && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null 
                            && request.auth.token.email == 'pwavwef@gmail.com'
                            && resource.data.userId == request.auth.uid;
    }

    // Meal plans collection (for meal planner)
    match /mealPlans/{planId} {
      allow read: if request.auth != null 
                  && request.auth.token.email == 'pwavwef@gmail.com';
      allow create: if request.auth != null 
                    && request.auth.token.email == 'pwavwef@gmail.com'
                    && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null 
                            && request.auth.token.email == 'pwavwef@gmail.com'
                            && resource.data.userId == request.auth.uid;
    }

    // Certificate orders collection (Midnight in Love event)
    match /certificateOrders/{orderId} {
      // Anyone can submit an order (payment is verified client-side via Paystack ref)
      allow create: if request.resource.data.keys().hasAll(['name', 'committee', 'email', 'phone', 'paymentRef', 'timestamp'])
                    && request.resource.data.name is string
                    && request.resource.data.committee is string
                    && request.resource.data.email is string
                    && request.resource.data.phone is string
                    && request.resource.data.paymentRef is string;
      // Only admin can read (formdata.html)
      allow read: if request.auth != null
                  && request.auth.token.email == 'pwavwef@gmail.com';
      // No updates or deletes from client
      allow update, delete: if false;
    }

    // Blue Mind Radio podcast episodes
    match /podcast_episodes/{episodeId} {
      // Public pages may read only published episodes. Admin may read all.
      allow get, list: if isAdmin() || resource.data.isPublished == true;
      allow create, update: if isAdmin() && hasPodcastEpisodeShape();
      allow delete: if isAdmin();
    }

    // Public podcast/show metadata, including show-level platform links
    match /podcast_settings/{settingId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
  }
}
